{
  "manifest_version": 3,
  "name": "Vim less mouse. Homemade",
  "version": "1.2.0",
  "description": "like Vim. less mouse.",
  "permissions": [
    "tabs",
    "storage",
    "history",
    "bookmarks"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_end",
      "all_frames": true
    }
  ],
  "options_page": "options.html",
  "action": {
    "default_title": "Vimium Homemade"
  }
}
